<IfModule mod_rewrite.c>
  RewriteEngine On
  # Relative substitution supports this directory. Vite currently builds for /.

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing assets must be 404s, never HTML disguised as an image or script.
  RewriteRule ^(?:assets|images|fonts|catalog-pages)(?:/|$) - [R=404,L]
  RewriteRule \.[^/]+$ - [R=404,L]

  # Internal rewrite only: keep /products and /products/:slug in the address bar.
  RewriteRule ^ index.html [L]
</IfModule>
