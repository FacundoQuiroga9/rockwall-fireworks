{
  "name": "rockwall-fireworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/catalog/build-pages.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test",
    "preview": "vite preview",
    "catalog:sync": "node scripts/catalog/sync.mjs",
    "catalog:check": "node scripts/catalog/sync.mjs --check",
    "catalog:frame": "python3 scripts/catalog/frame_products.py",
    "playground:fixtures": "node scripts/playground/review-fixtures.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "vite": "^6.4.3"
  }
}
